# HEH Backend Local Environment Defaults (Copy to .env if overriding; never commit .env)
HEH_ENV=development
HEH_API_HOST=127.0.0.1
HEH_API_PORT=8000
HEH_LOG_LEVEL=INFO
HEH_NLP_MODE=rules
HEH_SECRET_KEY=

# Optional feature flags
HEH_ENABLE_ML_RERANKER=false
HEH_ENABLE_ACCOUNT_SYNC=false
HEH_ENABLE_REDIRECT_TELEMETRY=false

# Optional PostgreSQL (Used only for auth/cloud-history; core search is Zero-DB)
# Uncomment if connecting locally (use 127.0.0.1 and set HEH_POSTGRES_PORT=5433 if 5432 is busy):
# HEH_DATABASE_URL=postgresql+psycopg://heh:heh_local_dev@127.0.0.1:5433/heh
HEH_DB_HEALTH_TIMEOUT_SECONDS=1.0
