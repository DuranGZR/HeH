# HEH Backend Local Environment Defaults (Copy to .env if overriding; never commit .env)
HEH_ENV=development
HEH_API_HOST=127.0.0.1
HEH_API_PORT=8000
HEH_LOG_LEVEL=INFO
HEH_NLP_MODE=rules
HEH_SECRET_KEY=

# Optional PostgreSQL (Used only for auth/cloud-history; core search is Zero-DB)
# Local Docker Compose default (override port if host already runs Postgres on 5432):
# HEH_DATABASE_URL=postgresql://heh:heh_local_dev@127.0.0.1:5432/heh
HEH_DATABASE_URL=
HEH_DB_HEALTH_TIMEOUT_SECONDS=1.0
