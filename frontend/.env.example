# HEH Mobile Public Environment Defaults (Copy to .env if overriding; never commit .env)
# Use http://10.0.2.2:8000 on Android Emulator when FastAPI runs on host machine
EXPO_PUBLIC_HEH_API_URL=http://127.0.0.1:8000
# Set to 1 to run without a backend using offline deterministic MockSearchTransport
EXPO_PUBLIC_HEH_USE_MOCK=0
